<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xuannie.devatlas.workspace.domain.repository.WorkspaceRepository">

    <!-- Property is the Spring Boot Var name we are populating from DB with the column val -->
    <resultMap id="WorkspaceResultMap" type="com.xuannie.devatlas.workspace.domain.entity.Workspace">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="slug" column="slug"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="visibility" column="visibility"/>
        <result property="category" column="category"/>
        <result property="permissions" column="permissions"/>
        <result property="homePageId" column="root_page_id"/>
        <result property="ownerId" column="owner_id"/>
        <result property="createdAt" column="created_at"/>
        <result property="modifiedAt" column="modified_at"/>
        <result property="archivedAt" column="archived_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.xuannie.devatlas.workspace.domain.entity.Workspace"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workspaces (name, slug, description, status, visibility, category, permissions, root_page_id,
        owner_id)
        VALUES (#{name}, #{slug}, #{description}, #{status}, #{visibility}, #{category}, #{permissions},
        #{homePageId}, #{ownerId})
    </insert>

    <select id="findById" resultMap="WorkspaceResultMap">
        SELECT * FROM workspaces WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="WorkspaceResultMap">
        SELECT * FROM workspaces WHERE owner_id = #{ownerId} ORDER BY name ASC;
    </select>

    <select id="existsById" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM workspaces WHERE id = #{id})
    </select>

    <update id="update" useGeneratedKeys="true" parameterType="com.xuannie.devatlas.workspace.domain.entity.Workspace">
        UPDATE workspaces
        <set>
            <!-- Left side is SQL, Right is Java -->
            <if test="name != null">name = #{name}, </if>
            <if test="slug != null">slug = #{slug}, </if>
            <if test="description != null">description = #{description}, </if>
            <if test="status != null">status = #{status}, </if>
            <if test="homePageId != null">root_page_id = #{homePageId}, </if>
            <if test="visibility != null">visibility = #{visibility}, </if>
            <if test="category != null">category = #{category}, </if>
            <if test="permissions != null">permissions = #{permissions}, </if>
            <if test="archivedAt != null">archived_at = #{archivedAt}, </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM workspaces WHERE id = #{id}
    </delete>

    <update id="clearArchivedAt">
        UPDATE workspaces SET archived_at = NULL, status = 'ACTIVE' WHERE id = #{id}
    </update>

    <select id="existsBySlug" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM workspaces WHERE slug = #{slug})
    </select>

    <select id="isExistingWorkspaceNameByOwner" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM workspaces
            WHERE owner_id = #{ownerId}
                AND name = #{name}
        )
    </select>
</mapper>